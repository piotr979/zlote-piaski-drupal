<?php

/**
 * Implements hook_theme().
 */
function pirate_slider_theme($existing, $type, $theme, $path) {
  return array(
    'pirate_slider' => array(
      'variables' => array('view' => NULL, 'rows' => NULL),
      'path' => \Drupal::service('extension.list.module')->getPath('pirate_slider') . '/templates',
    ),
  );
}

