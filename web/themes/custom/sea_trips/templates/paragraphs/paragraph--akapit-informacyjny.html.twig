{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - is_primary_color_dark: Determines if given background color is dark or not
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

{#
  potrzebny mi type,
  a wlasciwie kolor mozna wpisac od razu jako value
#}
{% set background_color = content.field_st_background_color['#items'].0.value %}

{% set text_color = is_primary_dark_color ? 'text-white' : 'text-gray-500' %}
{% set heading_color = is_primary_dark_color ? 'text-white' : 'text-black' %}
{% set border_color = is_primary_dark_color ? 'border-accent-light-color' : 'border-accent-dark-color' %}
{% set bg_color = is_primary_dark_color ? 'bg-primary-btn-color' : 'bg-secondary-btn-color' %}
{% set subheading_color = is_primary_dark_color ? 'text-accent-light-color' : 'text-accent-dark-color' %}

{{ dump(content)}}
{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}


{% set imagePosition = content.field_st_image_position.0['#markup'] %}
{{ dump(imagePosition)}}
{{ dump('jako' )}}
{% set basisOrientation = imagePosition == 'Po prawej' ? "basis-3/4" : "" %}
{% set imageOrientation = imagePosition == 'Po prawej' ? "md:flex-row" : "md:flex-row-reverse" %}

{% set is_image_added = content.field_st_image|render is not empty %}
{{ dump(is_image_added)}}

{% block paragraph %}
<div{{attributes.addClass(classes,'mt-4','lg:mt-8','py-8')}} style="background-color: {{ background_color}}">
 
    {% block content %}
    	<div class="py-4 px-4 md:px-8 lg:px-12 flex flex-col mt-2 xl:mt-4 mx-auto gap-x-16 lg:w-3/4
        {{ is_image_added ? 'md:justify-start' : 'md:justify-center' }} items-start {{ imageOrientation }}">
     	{# image container starts here #}
		{% if content.field_st_image|render %}
					<div class="features-image__wrapper mx-auto basis-3/4">
						{{ content.field_st_image }}
					</div>
				{% endif %}

			{# text container starts here #}
        	<div class="flex flex-col items-center {{ is_image_added ? 'md:items-start' : 'md:items-center' }} w-full">
 
     {% if content.field_st_subheader|render %}
						<div class="{{ subheading_color }} uppercase text-sm font-main-normal mt-4 
						md:mt-0 border-b {{ border_color }}"
						>
							{{ content.field_st_subheader }}
						</div>
					{% endif %}
					<div class="{{ heading_color }} font-heading text-4xl mt-2 text-center {{ is_image_added == true ? 'md:text-left' : '' }}">
						{{ content.field_st_title}}
					</div>
					<div class="{{ text_color }} text-base leading-6 text-center {{ is_image_added == true ? 'md:text-left' : '' }} pt-8">
						{{ content.field_st_description }}
					</div>
					{% if content.field_st_cta_link|render %}
						<a class="transition-all hover:bg-white hover:text-black px-12 py-4 mt-4 {{ bg_color }} rounded-md text-slate-700 font-main-normal w-fit" href="{{ content.field_st_cta_link.0['#url'].toString() }}">{{ content.field_st_cta_link.0['#title'] }}</a>
					{% endif %}
        </div>

    {% endblock %}
  
</div>
{% endblock paragraph %}
