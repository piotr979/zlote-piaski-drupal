{% set background_color = content.field_st_background_color['#items'].0.value %}

{% set is_dark = is_primary_dark_color %}

{%
  set classes = [
    'paragraph',
    'paragraph--type--' ~ paragraph.bundle|clean_class,
    view_mode ? 'paragraph--view-mode--' ~ view_mode|clean_class,
    not paragraph.isPublished() ? 'paragraph--unpublished'
  ]
%}

{% block paragraph %}
<div {{ attributes.addClass(classes, 'mt-4', 'lg:mt-8', 'py-8') }} style="background-color: {{ background_color }}">

    {% block content %}
    <div class="py-4 px-4 md:px-8 lg:px-12 flex flex-col mt-2 xl:mt-4 mx-auto gap-x-16 lg:w-3/4 
        {{ content.field_st_image|render ? 'md:justify-start' : 'md:justify-center' }} 
        items-start 
        {{ content.field_st_image|render and content.field_st_image_position.0['#markup'] == 'Po prawej' ? 'md:flex-row' : 'md:flex-row-reverse' }}">
        
        {# Image container #}
        {% if content.field_st_image|render %}
            <div class="features-image__wrapper mx-auto basis-3/4">
                {{ content.field_st_image }}
            </div>
        {% endif %}

        {# Text container #}
        <div class="flex flex-col items-center 
            {{ content.field_st_image|render ? 'md:items-start' : 'md:items-center' }} w-full">

            {% if content.field_st_subheader|render %}
                <div class="{{ is_dark ? 'text-accent-light-color' : 'text-accent-dark-color' }} uppercase text-sm font-main mt-4 md:mt-0 border-b 
                    {{ is_dark ? 'border-accent-light-color' : 'border-accent-dark-color' }}">
                    {{ content.field_st_subheader }}
                </div>
            {% endif %}

            <div class="{{ is_dark ? 'text-white' : 'text-black' }} font-heading text-4xl mt-2 text-center 
                {{ content.field_st_image|render ? 'md:text-left' : '' }}">
                {{ content.field_st_title }}
            </div>

            <div class="{{ is_dark ? 'text-white' : 'text-gray-500' }} text-base leading-6 text-center 
                {{ content.field_st_image|render ? 'md:text-left' : '' }} pt-8">
                {{ content.field_st_description }}
            </div>

            {% if content.field_st_cta_link|render %}
                <a class="transition-all 
				{{ is_dark ? 'hover:bg-primary-btn-hov-color' : 'hover:bg-secondary-btn-hov-color' }} hover:text-black px-12 py-4 mt-4 
                    {{ is_dark ? 'bg-primary-btn-color' : 'bg-secondary-btn-color' }} 
                    rounded-md text-slate-700 font-main-normal w-fit" 
                    href="{{ content.field_st_cta_link.0['#url'].toString() }}">
                    {{ content.field_st_cta_link.0['#title'] }}
                </a>
            {% endif %}
        </div>

    {% endblock %}
</div>
{% endblock paragraph %}
